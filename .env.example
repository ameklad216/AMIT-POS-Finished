NODE_ENV=development
APP_HOST=127.0.0.1
APP_PORT=3100
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=project6_admin_ejs
SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters_long
# Set to 1 only when deployed behind one trusted HTTPS reverse proxy.
TRUST_PROXY=0

# Neon: paste the connection string from the Neon Connect dialog, including sslmode=require.
# When set, DATABASE_URL takes priority over DB_HOST / DB_NAME / other DB_* settings.
DATABASE_URL=
