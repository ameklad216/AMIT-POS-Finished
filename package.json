{
  "name": "admin-dashboard-ejs-sessions",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone Node.js, EJS and PostgreSQL admin dashboard with server-side sessions",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
