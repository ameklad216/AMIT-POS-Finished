<%# صفحة خطأ مشتركة؛ تظهر داخل لوحة التحكم للمستخدم المسجل أو مستقلة للزائر. %>
<%- include('partials/head') %>
<% if(user) { %>
<%- include('partials/header') %>
<% } %>
<section class="error-page">
  <div class="error-code">
    <%= status %>
  </div>
